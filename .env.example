# =====================================================================
# IBM watsonx.ai Configuration Template
# =====================================================================
# INSTRUCTIONS FOR BEGINNERS:
# 1. Do NOT put real secrets in this file (.env.example is shared in Git).
# 2. Make a copy of this file and rename the copy to '.env':
#      In PowerShell: copy .env.example .env
# 3. Open '.env' in your editor and replace the placeholder values below
#    with your actual IBM Cloud / watsonx.ai credentials.
# 4. The real '.env' file is ignored by Git (.gitignore) so your keys remain safe.
# =====================================================================

# 1. IBM Cloud API Key (generated in IBM Cloud IAM -> API Keys)
WATSONX_APIKEY=your_ibm_cloud_api_key_here

# 2. watsonx.ai Project ID (found in watsonx.ai project Manage -> General tab)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# 3. watsonx.ai Service URL (default is us-south, change if your instance is in another region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# 4. Foundation Model Identifier for IBM Granite
GRANITE_MODEL_ID=ibm/granite-4-h-small

# 5. Watson Machine Learning Service Instance ID (optional, binds to specific runtime)
WATSONX_INSTANCE_ID=your_watsonx_instance_id_here
